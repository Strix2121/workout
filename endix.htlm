['جوز',654,15,14,65,'حفنة',28],['تمر',282,2.5,75,0.4,'حبة',10],['زيت زيتون',884,0,0,100,'ملعقة كبيرة',13.5],
['زبدة',717,0.9,0.1,81,'ملعقة كبيرة',14],['عسل',304,0.3,82,0,'ملعقة صغيرة',7],['سكر',387,0,100,0,'ملعقة صغيرة',4],
['شوفان',389,17,66,7,'نص كوب',40],['واي بروتين (بودرة)',400,80,8,6,'مغرفة',30],['موز',89,1.1,23,0.3,'حبة',120],
['تفاح',52,0.3,14,0.2,'حبة',180],['برتقال',47,0.9,12,0.1,'حبة',130],['عنب',69,0.7,18,0.2,'حفنة',80],
['بطيخ',30,0.6,7.6,0.2,'شريحة',250],['خيار',15,0.7,3.6,0.1,'حبة',100],['بندورة',18,0.9,3.9,0.2,'حبة',120],
['عصير برتقال',45,0.7,10,0.2,'كوب',250],['كولا',42,0,10.6,0,'علبة',330],['شوكولاتة',546,5,60,31,'قطعة',10],
['ساندويتش شاورما دجاج',200,12,20,8,'ساندويتش',250],['ساندويتش شاورما لحم',230,12,19,11,'ساندويتش',250],['شاورما عربي (لحم بخبز عربي)',240,13,18,13,'ساندويتش',280],
['صحن شاورما دجاج (بدون خبز)',190,22,3,10,'صحن',250],['صحن شاورما لحم (بدون خبز)',250,20,2,18,'صحن',250],
