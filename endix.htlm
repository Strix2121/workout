<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#4a3bf0">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="تمارين">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%234a3bf0'/%3E%3Ctext x='50' y='68' font-size='56' text-anchor='middle'%3E%F0%9F%8F%8B%3C/text%3E%3C/svg%3E">
<title>برنامجي التدريبي</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef0f6;--card:#fff;--tx:#141a2e;--mu:#6b7390;--ac:#5b4bff;--tint:#efedff;--ln:#e1e4ef;--hero:#4a3bf0;--p:#ff5d5d;--c:#ffb020;--f:#12b5a6;color-scheme:light}
@media(prefers-color-scheme:dark){:root{--bg:#0d1120;--card:#171c31;--tx:#eef0fb;--mu:#99a0bf;--ac:#8a7dff;--tint:#252252;--ln:#262c47;--hero:#3a30b8;color-scheme:dark}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0}
body{background:var(--bg);color:var(--tx);font:16px/1.55 Tajawal,Tahoma,system-ui,sans-serif;padding:env(safe-area-inset-top) 0 calc(96px + env(safe-area-inset-bottom))}
main{max-width:560px;margin:auto;padding:14px}
button,input{font:inherit;color:inherit}
button{border:0;background:var(--tint);color:var(--ac);border-radius:12px;padding:8px 12px;cursor:pointer;font-weight:700}
button:active{transform:scale(.97)}
input{width:100%;min-width:0;background:var(--bg);border:1.5px solid transparent;border-radius:12px;padding:10px;text-align:center;font-weight:700}
input:focus{outline:0;border-color:var(--ac)}
input::placeholder{font-weight:400;color:var(--mu)}
h2,h3,p{margin:0}
/* nav */
#nav{position:fixed;inset:auto 0 0 0;z-index:8;display:flex;justify-content:center;gap:6px;padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:var(--card);border-top:1px solid var(--ln)}
#nav button{flex:1;max-width:180px;display:flex;flex-direction:column;align-items:center;gap:0;background:none;color:var(--mu);font-size:12px;padding:4px}
#nav button span{font-size:22px;line-height:1.3}
#nav button.on{color:var(--ac)}
/* hero */
.hero{background:var(--hero);color:#fff;border-radius:24px;padding:18px;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
.hero h2{font-size:28px;font-weight:800;line-height:1.2}
.hero small{opacity:.8}
.hero input{background:rgba(255,255,255,.16);color:#fff;font-size:20px;font-weight:800;text-align:start;padding:4px 8px;width:150px;margin:2px -8px}
.hero .st{display:flex;gap:16px;margin-top:8px;font-size:14px}
.hero b{font-size:18px}
.ring{position:relative;flex:none}
.ring b{position:absolute;inset:0;display:grid;place-items:center;font-size:18px}
/* days */
.days{display:flex;gap:8px;overflow-x:auto;padding:2px 2px 10px;scrollbar-width:none}
.days button{flex:0 0 auto;width:62px;padding:8px 0;background:var(--card);color:var(--tx);display:flex;flex-direction:column;align-items:center;line-height:1.25;border-radius:16px}
.days button b{font-size:18px}
.days small{font-size:11px;color:var(--mu)}
.days button.on{background:var(--ac);color:#fff}
.days button.on small{color:#fff;opacity:.85}
.days button.rest:not(.on){opacity:.6}
/* exercise */
.ex{background:var(--card);border-radius:20px;padding:14px;margin:12px 0}
.ex.fin{box-shadow:inset 0 0 0 2px var(--f)}
.eh{display:flex;align-items:center;gap:10px}
.eh .n{flex:none;width:30px;height:30px;border-radius:10px;background:var(--tint);color:var(--ac);display:grid;place-items:center;font-weight:800}
.eh h3{flex:1;font-size:17px;font-weight:700;line-height:1.3}
.eh button{padding:4px 8px;background:none;color:var(--mu)}
.chips{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}
.chip{display:flex;align-items:center;gap:6px;background:var(--bg);border-radius:12px;padding:3px 10px;font-size:14px;color:var(--mu)}
.chip input{width:52px;padding:4px;background:var(--card)}
.chip button{padding:2px 9px;font-size:18px;line-height:1.2}
.cols,.set{display:grid;grid-template-columns:34px 1fr 1fr 44px;gap:8px;align-items:center}
.cols{font-size:12px;color:var(--mu);text-align:center;margin-bottom:2px}
.set{margin:6px 0}
.set>span{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:var(--bg);font-weight:700;color:var(--mu)}
.set .ok{width:44px;height:44px;border-radius:50%;padding:0;background:var(--bg);color:transparent;font-size:20px}
.set.done .ok{background:var(--f);color:#fff}
.set.done input{background:var(--tint)}
.set.done>span{background:var(--f);color:#fff}
.add{width:100%;background:var(--ac);color:#fff;padding:13px;font-size:16px;border-radius:16px}
.nt{color:var(--mu);font-size:13px;margin-top:12px}
.empty{text-align:center;padding:30px 10px;color:var(--mu)}
/* meals */
.card{background:var(--card);border-radius:20px;padding:16px;margin:12px 0}
.dt{display:flex;align-items:center;justify-content:space-between;gap:8px}
.dt b{font-size:17px}
.big{display:flex;align-items:center;gap:16px}
.big h2{font-size:30px;font-weight:800;line-height:1.1}
.mac{flex:1;display:grid;gap:8px}
.mac div{font-size:13px;color:var(--mu)}
.mb{height:8px;border-radius:6px;background:var(--bg);overflow:hidden;margin-top:2px}
.mb i{display:block;height:100%;border-radius:6px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0}
.ml{display:flex;justify-content:space-between;align-items:center;gap:8px}
.ml small{color:var(--mu)}
.dot{display:inline-block;width:9px;height:9px;border-radius:3px;margin-inline-end:4px}
.ch{width:100%;height:auto}
.ch text{font-family:inherit}
.dn{width:160px;height:160px;border-radius:50%;margin:12px auto;display:grid;place-items:center}
.dn div{width:100px;height:100px;border-radius:50%;background:var(--card);display:grid;place-items:center;text-align:center;line-height:1.2;font-weight:800}
.dn small{display:block;font-weight:400;color:var(--mu)}
.lg{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;font-size:14px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fr{display:grid;gap:6px;max-height:230px;overflow:auto;margin:10px 0}
.fb{display:flex;justify-content:space-between;align-items:center;gap:8px;background:var(--bg);color:var(--tx);font-weight:500;text-align:start}
.fb small{color:var(--mu);white-space:nowrap}
.fsel{background:var(--tint);border-radius:16px;padding:12px;margin-top:8px}
select{width:100%;background:var(--bg);color:var(--tx);border:1.5px solid transparent;border-radius:12px;padding:10px;font:inherit;font-weight:700}
details summary{cursor:pointer;font-weight:700}
/* timer */
#tb{position:fixed;inset:auto 14px calc(84px + env(safe-area-inset-bottom)) 14px;max-width:532px;margin:auto;z-index:9;background:var(--tx);color:var(--bg);border-radius:18px;padding:10px 12px 10px 16px;display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:18px;box-shadow:0 8px 24px rgba(0,0,0,.25)}
#tb[hidden]{display:none}
#tb button{background:rgba(128,128,128,.3);color:inherit}
</style>
</head>
<body>
<main id="v"></main>
<div id="tb" hidden><span></span><button onclick="clearInterval(T);tb.hidden=true">إيقاف</button></div>
<nav id="nav"></nav>
<script>
const K='ali-shahidah-v1';
const mk=(n,s,r)=>({n,s,r,wk:{1:{w:Array(s).fill(''),q:Array(s).fill(''),d:Array(s).fill(false)}}});
const def=()=>({goal:2500,week:1,meals:{},days:[
{t:'Push',e:[mk('ضغط دمبل مائل للأعلى (صدر)',4,3),mk('فراشة صدر',3,2),mk('ضغط دمبل جانبي (أكتاف)',2,3),mk('رفرفة جانبية (كتف جانبي)',3,2),mk('دفع سيخ خلف الرأس (ترايسبس)',3,2),mk('دفع سيخ للأسفل (ترايسبس)',3,2),mk('طحن معدة بالحبل',3,2)]},
{t:'Pull',e:[mk('سحب أمامي ضيق',3,3),mk('تجديف ظهر ضيق',3,2),mk('تجديف ظهر عريض',2,2),mk('كيبل يد واحدة (كتف خلفي)',3,1.5),mk('دمبل متسع مائل (بايسبس)',3,1.5),mk('مطرقة',3,1.5),mk('كرسي روماني',3,1.5)]},
{t:'راحة',e:[]},
{t:'Legs',e:[mk('هاك سكوات',3,3),mk('RDL هامسترينغ',3,3),mk('رد أمامي',3,2),mk('رد خلفي',3,2),mk('مقرّبات',3,1.5),mk('بطات واقفة',3,1.5),mk('فواصل يد واحدة',2,1.5)]},
{t:'راحة',e:[]},
{t:'Upper',e:[mk('فتح كيبل صدر علوي',3,2),mk('سحب بولي داون',3,3),mk('رفرفة جانبية بالكيبل',3,2),mk('سحب يد واحدة (كتف خلفي)',2,1.5),mk('دفع سيخ خلف الرأس (ترايسبس)',3,2),mk('تبادل دمبل (بايسبس)',2,1.5),mk('دوران جذع بالكيبل',2,1.5)]},
{t:'راحة',e:[]}]});
let S;try{S=JSON.parse(localStorage.getItem(K))}catch(e){}
S=S||def();
function mig(d){d.week=d.week||1;d.days.forEach(y=>y.e.forEach(x=>{if(!x.wk){x.wk={1:{w:x.w||[],q:x.q||(x.w||[]).map(()=> ''),d:x.d||[]}};delete x.w;delete x.q;delete x.d}}));return d}
mig(S);
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const iso=d=>new Date(d.getTime()-d.getTimezoneOffset()*6e4).toISOString().slice(0,10);
const today=()=>iso(new Date());
let em=-1,tab='w',di=0,date=today(),T=null,pg=null;
const go=t=>{tab=t;scrollTo(0,0);R()};
function ring(p,sz,sw,col,track){const r=(sz-sw)/2,c=2*Math.PI*r;return `<svg width="${sz}" height="${sz}" viewBox="0 0 ${sz} ${sz}" style="transform:rotate(-90deg)"><circle cx="${sz/2}" cy="${sz/2}" r="${r}" fill="none" stroke="${track}" stroke-width="${sw}"/><circle cx="${sz/2}" cy="${sz/2}" r="${r}" fill="none" stroke="${col}" stroke-width="${sw}" stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${c*(1-Math.min(1,p))}"/></svg>`}
function R(){
 $('#nav').innerHTML=[['w','🏋️','التمارين'],['m','🍽️','السعرات'],['c','📊','الرسم'],['s','⚙️','الإعدادات']].map(([k,i,l])=>`<button class="${tab==k?'on':''}" onclick="go('${k}')"><span>${i}</span>${l}</button>`).join('');
 $('#v').innerHTML=bn()+(tab=='w'?RW():tab=='m'?RM():tab=='c'?RC():RS());
 if(tab=='m'){fs('');cr()}
}
/* ---------- التمارين ---------- */
function RW(){
 const D=S.days[di];
 const tt=D.e.reduce((a,x)=>a+x.s,0),dn=D.e.reduce((a,x)=>a+mg(x,S.week).d.filter(Boolean).length,0),ex=D.e.filter(x=>mg(x,S.week).d.every(Boolean)).length,p=tt?dn/tt:0;
 let h=`<div class="hero"><div><small>اليوم ${di+1} من 7</small><input value="${esc(D.t)}" onchange="S.days[di].t=this.value||'يوم';save();R()"><div class="st"><span><b>${ex}/${D.e.length}</b> تمارين</span><span><b>${dn}/${tt}</b> مجموعات</span></div></div>
 <div class="ring">${ring(p,84,9,'#fff','rgba(255,255,255,.25)')}<b>${Math.round(p*100)}%</b></div></div>
 <div class="card dt" style="margin:0 0 10px;padding:8px 10px"><button onclick="sw(-1)">›</button><b>الأسبوع ${S.week}</b><button onclick="sw(1)">‹</button></div><div class="days">${S.days.map((d,i)=>`<button class="${i==di?'on':''} ${d.e.length?'':'rest'}" onclick="di=${i};R()"><b>${i+1}</b><small>${esc(d.t)}</small></button>`).join('')}</div>`;
 if(!D.e.length)h+=`<div class="empty">يوم راحة 😴<br>ضيف تمرين إذا بدك تتمرن اليوم.</div>`;
 D.e.forEach((x,i)=>{
  const o=mg(x,S.week);h+=`<div class="ex ${o.d.every(Boolean)?'fin':''}"><div class="eh"><span class="n">${i+1}</span><h3>${esc(x.n)}</h3><button onclick="pgt(${i})">📈</button><button onclick="ren(${i})">✎</button><button onclick="del(${i})">🗑</button></div>
  <div class="chips"><label class="chip">راحة <input type="number" step="0.5" min="0" value="${x.r}" onchange="S.days[di].e[${i}].r=+this.value;save()"> د</label><button onclick="tm(S.days[di].e[${i}].r)">⏱ ابدأ</button>
  <span class="chip"><button onclick="sc(${i},-1)">−</button>${x.s} مجموعات<button onclick="sc(${i},1)">+</button></span></div>
  <div class="cols"><span></span><span>الوزن (كغ)</span><span>العدات</span><span></span></div>
  ${o.w.map((w,j)=>`<div class="set ${o.d[j]?'done':''}"><span>${j+1}</span><input type="number" inputmode="decimal" placeholder="0" value="${esc(w)}" onchange="E(${i}).w[${j}]=this.value;save()"><input type="number" inputmode="numeric" placeholder="0" value="${esc(o.q[j]||'')}" onchange="E(${i}).q[${j}]=this.value;save()"><button class="ok" onclick="ck(${i},${j})">✓</button></div>`).join('')}${pg&&pg[0]==di&&pg[1]==i?pc(x):''}</div>`;
 });
 return h+`<button class="add" onclick="ad()">+ تمرين جديد</button><p class="nt">الشدة: قبل الفشل العضلي بـ 1-2 عدّة. الزفير عند بذل العزم والشهيق عند الإرخاء. سخّن بإطالات حركية قبل التمرين وإطالات ثابتة بعده.</p><p class="nt"><button onclick="rd()">صفّر علامات اليوم</button></p>`;
}
function mg(x,wk){
 x.wk=x.wk||{};
 if(!x.wk[wk]){let p=null;for(let k=wk-1;k>=1;k--)if(x.wk[k]){p=x.wk[k];break}
  x.wk[wk]={w:p?p.w.slice():[],q:p?p.q.slice():[],d:[]}}
 const o=x.wk[wk];
 while(o.w.length<x.s){o.w.push('');o.q.push('')}while(o.w.length>x.s){o.w.pop();o.q.pop()}
 o.d=Array.from({length:x.s},(_,i)=>!!o.d[i]);
 return o}
function E(i){return mg(S.days[di].e[i],S.week)}
function sw(n){S.week=Math.max(1,S.week+n);save();R()}
function ck(i,j){const x=S.days[di].e[i],o=E(i);o.d[j]=!o.d[j];save();if(o.d[j]&&j<x.s-1&&S.at!==false)tm(x.r);R()}
function rd(){S.days[di].e.forEach(x=>{const o=mg(x,S.week);o.d=o.d.map(()=>false)});save();R()}
function ren(i){const x=S.days[di].e[i],n=prompt('اسم التمرين',x.n);if(n){x.n=n;save();R()}}
function del(i){if(confirm('احذف التمرين؟')){S.days[di].e.splice(i,1);save();R()}}
function sc(i,d){const x=S.days[di].e[i];if(x.s+d<1)return;x.s+=d;save();R()}
function ad(){const n=prompt('اسم التمرين');if(n){S.days[di].e.push(mk(n,3,2));save();R()}}
function tm(m){
 clearInterval(T);let s=Math.round(m*60);const b=$('#tb'),sp=b.querySelector('span');b.hidden=false;
 const u=()=>{sp.textContent='⏱ راحة '+Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};u();
 T=setInterval(()=>{s--;u();if(s<=0){clearInterval(T);sp.textContent='خلصت الراحة، يلا كمّل 💪';if(navigator.vibrate)navigator.vibrate([300,100,300]);setTimeout(()=>b.hidden=true,5000)}},1000);
}
/* ---------- السعرات ---------- */
const tot=d=>(S.meals[d]||[]).reduce((a,m)=>({k:a.k+m.k,p:a.p+m.p,c:a.c+m.c,f:a.f+m.f}),{k:0,p:0,c:0,f:0});
const dname=d=>d==today()?'اليوم':new Date(d+'T12:00').toLocaleDateString('ar',{weekday:'long',day:'numeric',month:'long'});
function sd(n){em=-1;const d=new Date(date+'T12:00');d.setDate(d.getDate()+n);date=iso(d);R()}
function datebar(){return `<div class="dt"><button onclick="sd(-1)">›</button><b>${dname(date)}</b><button onclick="sd(1)">‹</button></div>`}
function RM(){
 const L=S.meals[date]||[],t=tot(date),left=S.goal-t.k;
 const mb=(l,v,col,g)=>`<div>${l} ${v}غ<div class="mb"><i style="width:${Math.min(100,v/g*100)}%;background:${col}"></i></div></div>`;
 return `<div class="card">${datebar()}<div class="big" style="margin-top:12px"><div class="ring">${ring(t.k/S.goal,110,12,'var(--ac)','var(--bg)')}<b style="font-size:13px;text-align:center;line-height:1.1">${t.k}<br>سعرة</b></div>
 <div class="mac"><div><h2>${Math.abs(left)}</h2>${left>=0?'سعرة باقية':'سعرة فوق الهدف'}</div>${mb('بروتين',t.p,'var(--p)',S.mt?S.mt.p:150)}${mb('كارب',t.c,'var(--c)',S.mt?S.mt.c:300)}${mb('دهون',t.f,'var(--f)',S.mt?S.mt.f:80)}</div></div>
 <div class="chips" style="margin-bottom:0"><label class="chip">الهدف اليومي <input type="number" value="${S.goal}" onchange="S.goal=+this.value||2500;save();R()"> سعرة</label></div></div>
 <details class="card" ${cop?'open':''} ontoggle="cop=this.open"><summary>🧮 حاسبة السعرات (كم لازم تاكل باليوم؟)</summary>
 <div class="two" style="margin-top:10px"><select onchange="cc('sx',this.value)">${opts([['m','ذكر'],['f','أنثى']],cv('sx','m'))}</select><input type="number" inputmode="numeric" placeholder="العمر (سنة)" value="${esc(cv('a',''))}" oninput="cc('a',this.value)"></div>
 <div class="two" style="margin-top:8px"><input type="number" inputmode="decimal" placeholder="الوزن (كغ)" value="${esc(cv('w',''))}" oninput="cc('w',this.value)"><input type="number" inputmode="decimal" placeholder="الطول (سم)" value="${esc(cv('h',''))}" oninput="cc('h',this.value)"></div>
 <select style="margin-top:8px" onchange="cc('act',+this.value)">${opts(ACT,cv('act',1.55))}</select>
 <select style="margin-top:8px" onchange="cc('g',+this.value)">${opts(GL,cv('g',0))}</select>
 <div id="cres" style="margin-top:12px"></div></details>
 <div class="card"><h3>أضف من قائمة الأكل</h3><input id="fsq" placeholder="ابحث: دجاج، رز، بيض..." style="text-align:start;margin-top:10px" oninput="fs(this.value)"><div id="frs" class="fr"></div><div id="fpn"></div></div>
 <details class="card"><summary>إضافة يدوية (أكلة مش بالقائمة)</summary><div style="margin-top:10px"><input id="mn" placeholder="اسم الوجبة" style="text-align:start"></div><div class="g4"><input id="mk" type="number" inputmode="decimal" placeholder="سعرات"><input id="mp" type="number" inputmode="decimal" placeholder="بروتين"><input id="mc" type="number" inputmode="decimal" placeholder="كارب"><input id="mf" type="number" inputmode="decimal" placeholder="دهون"></div><label class="nt"><input id="ms" type="checkbox" style="width:20px;height:20px;vertical-align:middle"> احفظها بقائمة الأكل (كحصة)</label><button class="add" onclick="am()" style="margin-top:10px">+ أضف</button><p class="nt">اترك السعرات فاضية وبنحسبها من الماكروز.</p></details>`
 +(L.length?'':cyb()+'<div class="empty">ما في وجبات مسجلة لهاليوم.</div>')
 +L.map((m,i)=>em===i?`<div class="card"><input id="en" value="${esc(m.n)}" style="text-align:start"><div class="g4"><input id="ek" type="number" inputmode="decimal" value="${m.k}"><input id="ep" type="number" inputmode="decimal" value="${m.p}"><input id="ec" type="number" inputmode="decimal" value="${m.c}"><input id="ef" type="number" inputmode="decimal" value="${m.f}"></div><p class="nt" style="margin:0">سعرات · بروتين · كارب · دهون</p><div class="two" style="margin-top:8px"><button class="add" onclick="es(${i})">حفظ</button><button onclick="em=-1;R()">إلغاء</button></div></div>`:`<div class="card ml"><span><b>${esc(m.n)}</b><br><small>${m.k} سعرة · <span class="dot" style="background:var(--p)"></span>${m.p} <span class="dot" style="background:var(--c)"></span>${m.c} <span class="dot" style="background:var(--f)"></span>${m.f}</small></span><span><button onclick="em=${i};R()">✎</button> <button onclick="dm(${i})">🗑</button></span></div>`).join('');
}
function am(){
 const v=id=>+$('#'+id).value||0,n=$('#mn').value.trim()||'وجبة';
 const p=v('mp'),c=v('mc'),f=v('mf'),k=v('mk')||Math.round(p*4+c*4+f*9);
 if(!k)return;if($('#ms')&&$('#ms').checked)(S.foods=S.foods||[]).push([n,k,p,c,f,'حصة',100]);(S.meals[date]=S.meals[date]||[]).push({n,k,p,c,f});save();R();
}
function dm(i){if(!confirm('احذف هالوجبة؟'))return;S.meals[date].splice(i,1);save();R()}
function es(i){
 const v=id=>+$('#'+id).value||0,m=S.meals[date][i],p=v('ep'),c=v('ec'),f=v('ef');
 m.n=$('#en').value.trim()||m.n;m.p=p;m.c=c;m.f=f;m.k=v('ek')||Math.round(p*4+c*4+f*9);
 em=-1;save();R();
}
/* قائمة الأكل: [الاسم, سعرات, بروتين, كارب, دهون] لكل 100غ + [وحدة, وزنها بالغرام] */
