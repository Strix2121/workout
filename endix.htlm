['منقوشة زعتر',300,8,40,12,'منقوشة',120],['منقوشة جبنة',320,12,35,15,'منقوشة',120],['جبنة حلوم',321,21,2,25,'قطعة',30],
['كبة مقلية',270,12,20,15,'حبة',70],['ورق عنب',150,3,22,6,'حبة',15],['محشي كوسا',150,6,18,6,'حبة',80],
['مقلوبة دجاج',170,9,20,6,'صحن',350],['منسف لحم',230,12,22,10,'صحن',400],['مسخن',260,13,27,11,'قطعة',300],['فتة حمص',200,8,22,9,'صحن',300],
['شكشوكة',110,6,6,7,'صحن',250],['عجة بيض',190,10,5,14,'قطعة',80],['بيتزا',266,11,33,10,'شريحة',107],['برغر لحم (ساندويتش)',250,13,24,11,'ساندويتش',220],
['شيبس',536,7,53,34,'كيس',40],['كنافة',360,6,45,18,'قطعة',120],['بقلاوة',430,6,50,24,'قطعة',40]];
const allF=()=>{
 const fx=S.fx||{},A=[];
 FOODS.forEach(f=>{const v=fx[f[0]];if(v===null)return;const a=(v||f).slice();a.src='b';a.o=f[0];A.push(a)});
 (S.foods||[]).forEach((f,i)=>{const a=f.slice();a.src='c';a.o=i;A.push(a)});
 return A};
const r1=v=>Math.round(v*10)/10;
let fsel=null;
function fs(q){
 q=(q||'').trim();const A=allF(),r=A.filter(f=>nz(f[0]).includes(nz(q)));
 $('#frs').innerHTML=r.map(f=>`<button class="fb" onclick="fp(${A.indexOf(f)})"><span>${esc(f[0])}</span><small>${f[1]} سعرة/100غ</small></button>`).join('')||'<p class="nt">ما لقينا الأكلة. أضفها يدوي تحت.</p>';
}
function fp(i){
 const f=fsel=allF()[i];
 $('#fpn').innerHTML=`<div class="fsel"><b>${esc(f[0])}</b><div class="two" style="margin:8px 0"><input id="fq" type="number" inputmode="decimal" step="any" value="${f[5]?1:100}" oninput="pv()"><select id="fu" onchange="$('#fq').value=this.value=='u'?1:100;pv()">${f[5]?`<option value="u">${esc(f[5])} (~${f[6]}غ)</option>`:''}<option value="g">غرام</option></select></div><div id="pvw" class="nt"></div><button class="add" onclick="fa()" style="margin-top:10px">+ أضف للوجبات</button><div class="two" style="margin-top:8px"><button onclick="fe()">✎ عدّل الأكلة</button><button onclick="fdl()">🗑 احذفها من القائمة</button></div></div>`;
 pv();$('#fpn').scrollIntoView({block:'nearest'});
}
function fe(){
 const f=fsel,ix=allF().findIndex(x=>x.src==f.src&&x.o==f.o);
 $('#fpn').innerHTML=`<div class="fsel"><b>تعديل الأكلة (القيم لكل 100 غرام)</b><input id="xn" value="${esc(f[0])}" style="text-align:start;margin-top:8px"><div class="g4"><input id="xk" type="number" inputmode="decimal" value="${f[1]}"><input id="xp" type="number" inputmode="decimal" value="${f[2]}"><input id="xc" type="number" inputmode="decimal" value="${f[3]}"><input id="xf" type="number" inputmode="decimal" value="${f[4]}"></div><p class="nt" style="margin:0">سعرات · بروتين · كارب · دهون (لكل 100غ)</p><div class="two" style="margin-top:8px"><input id="xu" value="${esc(f[5]||'')}" placeholder="اسم الوحدة (بيضة، صحن)"><input id="xg" type="number" inputmode="decimal" value="${f[6]||''}" placeholder="وزنها بالغرام"></div><div class="two" style="margin-top:8px"><button class="add" onclick="fsv()">حفظ</button><button onclick="fp(${ix})">إلغاء</button></div></div>`;
}
function fsv(){
 const v=id=>+$('#'+id).value||0,n=$('#xn').value.trim();if(!n)return;
 const u=$('#xu').value.trim(),g=v('xg'),a=[n,v('xk'),v('xp'),v('xc'),v('xf')];
 if(u&&g>0)a.push(u,g);
 if(fsel.src=='b'){S.fx=S.fx||{};S.fx[fsel.o]=a}else S.foods[fsel.o]=a;
 save();R();
}
function fdl(){
 if(!confirm('تحذف "'+fsel[0]+'" من قائمة الأكل؟'))return;
 if(fsel.src=='b'){S.fx=S.fx||{};S.fx[fsel.o]=null}else S.foods.splice(fsel.o,1);
 save();R();
}
function rf(){if(confirm('بدك ترجّع قائمة الأكل الأصلية؟ بيلغي تعديلاتك وحذفك للأكلات الأساسية (الأكلات اللي أضفتها إنت بتضل).')){S.fx={};save();R()}}
function fg(){const q=+$('#fq').value||0;return $('#fu').value=='u'?q*fsel[6]:q}
function pv(){const m=fg()/100,f=fsel;$('#pvw').innerHTML=`<b style="color:var(--tx);font-size:18px">${Math.round(f[1]*m)} سعرة</b> · بروتين ${r1(f[2]*m)}غ · كارب ${r1(f[3]*m)}غ · دهون ${r1(f[4]*m)}غ`}
function fa(){
 const m=fg()/100,f=fsel,q=+$('#fq').value||0;if(!q)return;
 const u=$('#fu').value=='u';
 (S.meals[date]=S.meals[date]||[]).push({n:`${f[0]} · ${q} ${u?f[5]:'غ'}`,k:Math.round(f[1]*m),p:r1(f[2]*m),c:r1(f[3]*m),f:r1(f[4]*m)});
 save();R();
}
const nz=s=>s.replace(/[أإآ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/[\u064B-\u0652]/g,'');
function pd(d){const x=new Date(d+'T12:00');x.setDate(x.getDate()-1);return iso(x)}
function cyb(){const p=S.meals[pd(date)];return p&&p.length?`<div class="card"><button class="add" onclick="cy()">انسخ وجبات اليوم السابق (${p.reduce((a,m)=>a+m.k,0)} سعرة)</button></div>`:''}
function cy(){const p=S.meals[pd(date)]||[];S.meals[date]=(S.meals[date]||[]).concat(p.map(m=>({...m})));save();R()}
function pgt(i){pg=pg&&pg[0]==di&&pg[1]==i?null:[di,i];R()}
function pc(x){
 const ks=Object.keys(x.wk||{}).map(Number).sort((a,b)=>a-b),vs=ks.map(k=>Math.max(0,...x.wk[k].w.map(v=>+v||0)));
 if(!vs.some(v=>v>0))return '<p class="nt">سجّل أوزان لتشوف التقدم.</p>';
 const n=ks.length,mx=Math.max(...vs),mn=Math.min(...vs),st=n>1?250/(n-1):0,X=i=>n>1?275-i*st:150,Y=v=>mx==mn?50:95-(v-mn)/(mx-mn)*60;
 const pts=vs.map((v,i)=>X(i)+','+Y(v)).join(' ');
 return `<div style="margin-top:12px"><p class="nt" style="margin:0 0 4px">أعلى وزن بكل أسبوع (كغ)</p><svg class="ch" viewBox="0 0 300 120"><polyline points="${pts}" fill="none" stroke="var(--ac)" stroke-width="2.5"/>${vs.map((v,i)=>`<circle cx="${X(i)}" cy="${Y(v)}" r="4" fill="var(--ac)"/><text x="${X(i)}" y="${Y(v)-9}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--tx)">${v}</text><text x="${X(i)}" y="115" text-anchor="middle" font-size="10" fill="var(--mu)">أ${ks[i]}</text>`).join('')}</svg></div>`;
}
/* ---------- حاسبة السعرات ---------- */
let cop=false;
const cv=(k,d)=>S.calc&&S.calc[k]!=null?S.calc[k]:d;
const opts=(L,cur)=>L.map(([v,l])=>`<option value="${v}" ${v==cur?'selected':''}>${l}</option>`).join('');
const ACT=[[1.2,'قليل الحركة (بدون تمرين)'],[1.375,'نشاط خفيف (تمرين 1-3 أيام)'],[1.55,'نشاط متوسط (تمرين 3-5 أيام)'],[1.725,'نشاط عالي (تمرين 6-7 أيام)']];
const GL=[[-0.2,'هدفي: خسارة دهون (-20%)'],[0,'هدفي: ثبات الوزن'],[0.1,'هدفي: زيادة عضل (+10%)']];
function cc(k,v){S.calc=S.calc||{};S.calc[k]=v;save();cr()}
function cr(){
 const e=$('#cres');if(!e)return;
 const a=+cv('a',0),w=+cv('w',0),h=+cv('h',0);
 if(!a||!w||!h){e.innerHTML='<p class="nt">دخّل عمرك ووزنك وطولك لتشوف النتيجة.</p>';return}
 if(a<14||a>90||w<30||w>250||h<120||h>230){e.innerHTML='<p class="nt" style="color:#d33">تأكد من القيم (العمر بالسنين، الوزن بالكغ، الطول بالسم).</p>';return}
 const bmr=10*w+6.25*h-5*a+(cv('sx','m')=='f'?-161:5),tdee=bmr*cv('act',1.55),t=Math.round(tdee*(1+cv('g',0)));
 const p=Math.round(w*2),f=Math.round(w*0.8),cb=Math.max(0,Math.round((t-p*4-f*9)/4));
 e.innerHTML=`<p class="nt" style="margin:0 0 8px">الحرق الأساسي (BMR): <b>${Math.round(bmr)}</b> · حرقك اليومي مع نشاطك: <b>${Math.round(tdee)}</b> سعرة</p>
 <div class="fsel" style="margin-top:0"><b style="font-size:22px">${t} سعرة باليوم</b><div class="nt" style="margin:4px 0 0">بروتين ${p}غ · كارب ${cb}غ · دهون ${f}غ</div><button class="add" onclick="sg(${t},${p},${cb},${f})" style="margin-top:10px">اعتمدها كهدف يومي</button></div>
 <p class="nt">تقدير تقريبي بمعادلة Mifflin-St Jeor، والبروتين 2غ لكل كغ والدهون 0.8غ لكل كغ. راقب وزنك 2-3 أسابيع وعدّل الهدف حسب النتيجة.</p>`;
}
function sg(t,p,c,f){S.goal=t;S.mt={p,c,f};save();R()}
/* ---------- الإعدادات والنسخ ---------- */
function hasD(){return Object.keys(S.meals).length>0||S.days.some(d=>d.e.some(x=>Object.values(x.wk||{}).some(o=>o.w.some(Boolean))))}
function bn(){return tab!='s'&&hasD()&&(!S.bk||Date.now()-S.bk>6048e5)?`<div class="card dt" style="margin:0 0 10px;padding:10px 12px;background:var(--tint)"><span class="nt" style="margin:0;color:var(--tx)">⚠️ ما خدت نسخة احتياطية من أسبوع. بياناتك محفوظة عالمتصفح بس.</span><button onclick="go('s')">خد نسخة</button></div>`:''}
function RS(){
 const b=S.bk?new Date(S.bk).toLocaleDateString('ar',{weekday:'long',day:'numeric',month:'long'}):'ما أخدت ولا وحدة';
 return `<div class="card"><h3>النسخة الاحتياطية</h3><p class="nt">آخر نسخة: ${b}</p>
 <button class="add" onclick="shT()" style="margin-top:10px">📤 شارك النسخة (واتساب، ملاحظات...)</button>
 <div class="two" style="margin-top:8px"><button onclick="cp()">📋 انسخ النسخة</button><button onclick="shF()">📎 شارك كملف</button></div>
 <div class="two" style="margin-top:8px"><button onclick="ex()">⬇️ حمّل ملف</button><button onclick="$('#imf').click()">📂 استرجع من ملف</button></div>
 <input id="imf" type="file" hidden onchange="im(this.files[0])">
 <p id="bs" class="nt" style="color:var(--tx)"></p>
 <details id="bkd"><summary class="nt">النص (للنسخ أو الاسترجاع اليدوي)</summary><textarea id="bkt" readonly rows="4" style="width:100%;margin-top:8px;border-radius:12px;border:0;background:var(--bg);color:var(--tx);padding:8px;font:12px monospace;direction:ltr">${esc(bj())}</textarea><textarea id="rtx" rows="3" placeholder="الصق النسخة هون للاسترجاع" style="width:100%;margin-top:8px;border-radius:12px;border:0;background:var(--bg);color:var(--tx);padding:8px;font:12px monospace;direction:ltr"></textarea><button onclick="ld($('#rtx').value)" style="width:100%;margin-top:8px">استرجع من النص</button></details>
 <p class="nt">الأسهل: اضغط "شارك النسخة" وابعتها لنفسك على واتساب أو احفظها بالملاحظات. للاسترجاع افتح "النص" والصقها بالصندوق الثاني.</p></div>
 <div class="card"><h3>إعدادات</h3><label class="nt" style="display:flex;gap:10px;align-items:center"><input type="checkbox" style="width:24px;height:24px" ${S.at!==false?'checked':''} onchange="S.at=this.checked;save()"> شغّل مؤقت الراحة تلقائياً لما أعلّم مجموعة</label></div>
 <div class="card"><h3>حتى ما تضيع بياناتك</h3><p class="nt">آيفون: افتح الموقع بسفاري ← مشاركة ← "إضافة إلى الشاشة الرئيسية". بدونها آيفون ممكن يمسح بيانات المواقع إذا ما فتحتها أسبوع.<br>أندرويد: كروم ← ⋮ ← "تثبيت التطبيق" أو "إضافة إلى الشاشة الرئيسية".<br>لا تفتح الموقع بوضع التصفح الخفي، ولا تمسح بيانات الموقع من إعدادات المتصفح.</p></div>
 <div class="card"><button onclick="rf()" style="width:100%">رجّع قائمة الأكل الأصلية</button></div>
 <div class="card"><button onclick="wipe()" style="width:100%;color:#d33">مسح كل البيانات</button></div>`;
}
/* ---------- الرسم البياني ---------- */
function RC(){
 const ds=[];for(let i=6;i>=0;i--){const d=new Date(date+'T12:00');d.setDate(d.getDate()-i);ds.push(iso(d))}
 const TT=ds.map(tot),mx=Math.max(S.goal,...TT.map(t=>t.k),1)*1.15,H=150,gy=H+10-S.goal/mx*H;
 let s=`<svg class="ch" viewBox="0 0 330 200"><line x1="0" x2="330" y1="${gy}" y2="${gy}" stroke="var(--mu)" stroke-dasharray="4"/>`;
 TT.forEach((t,i)=>{
  const x=(6-i)*47+8;let y=H+10;const o=Math.max(0,t.k-t.p*4-t.c*4-t.f*9);
  [[t.p*4,'--p'],[t.c*4,'--c'],[t.f*9,'--f'],[o,'--ln']].forEach(([v,c])=>{const h=v/mx*H;y-=h;s+=`<rect x="${x}" y="${y}" width="34" height="${h}" fill="var(${c})" rx="3"/>`});
  s+=`<text x="${x+17}" y="${y-4}" text-anchor="middle" font-size="10" font-weight="700" fill="var(--tx)">${t.k||''}</text><text x="${x+17}" y="190" text-anchor="middle" font-size="10" fill="var(--mu)">${new Date(ds[i]+'T12:00').toLocaleDateString('ar',{weekday:'short'})}</text>`;
 });
 s+='</svg>';
 const t=tot(date),a=t.p*4,b=t.c*4,c=t.f*9,sum=a+b+c,pa=a/sum*100,pb=pa+b/sum*100,pc=v=>sum?Math.round(v/sum*100):0;
 const bg=sum?`conic-gradient(var(--p) 0 ${pa}%,var(--c) ${pa}% ${pb}%,var(--f) ${pb}% 100%)`:'var(--ln)';
 const lg=(l,g,col,v)=>`<span><i class="dot" style="background:${col}"></i>${l} ${g}غ (${pc(v)}%)</span>`;
 return `<div class="card">${datebar()}</div>
 <div class="card"><h3>آخر 7 أيام</h3>${s}<p class="nt" style="margin-top:0">الخط المتقطع هو هدفك اليومي (${S.goal} سعرة).</p></div>
 <div class="card"><h3>شو بيحتوي أكل ${dname(date)}</h3><div class="dn" style="background:${bg}"><div><span>${t.k}<small>سعرة</small></span></div></div>
 <div class="lg">${lg('بروتين',t.p,'var(--p)',a)}${lg('كارب',t.c,'var(--c)',b)}${lg('دهون',t.f,'var(--f)',c)}</div></div>
 `;
}
const bj=()=>JSON.stringify(S);
function bm(t){const e=$('#bs');if(e)e.textContent=t}
function dn_(){S.bk=Date.now();save()}
async function shT(){
 if(navigator.share){try{await navigator.share({title:'نسخة احتياطية - برنامجي التدريبي',text:bj()});dn_();bm('✅ تمت المشاركة');return}catch(e){if(e&&e.name=='AbortError')return}}
 cp();
}
async function cp(){
 const t=bj();
 try{await navigator.clipboard.writeText(t);dn_();bm('✅ انتسخت النسخة. الصقها بالملاحظات أو ابعتها لنفسك على واتساب.');return}catch(e){}
 try{const d=$('#bkd');if(d)d.open=true;const a=$('#bkt');a.focus();a.select();a.setSelectionRange(0,t.length+1);if(document.execCommand('copy')){dn_();bm('✅ انتسخت النسخة. الصقها بالملاحظات أو ابعتها لنفسك على واتساب.');return}}catch(e){}
 bm('ما قدرت أنسخ تلقائي. انسخ النص من الصندوق تحت بإيدك (اضغط عليه ثم تحديد الكل ثم نسخ).');
}
async function shF(){
 const f=new File([bj()],'workout-backup-'+today()+'.txt',{type:'text/plain'});
 if(navigator.canShare&&navigator.canShare({files:[f]})){try{await navigator.share({files:[f]});dn_();bm('✅ تمت المشاركة');return}catch(e){if(e&&e.name=='AbortError')return}}
 bm('مشاركة الملفات مش مدعومة بهالمتصفح. استعمل "شارك النسخة" أو "انسخ".');
}
function ex(){
 try{const u=URL.createObjectURL(new Blob([bj()],{type:'application/json'})),a=document.createElement('a');a.href=u;a.download='workout-backup-'+today()+'.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),4000);dn_();bm('إذا ما نزل ملف، افتح الموقع من كروم أو سفاري مباشرة (مش من داخل تطبيق) أو استعمل "شارك النسخة".')}
 catch(e){bm('التحميل مش مدعوم هون. استعمل "شارك النسخة" أو "انسخ".')}
}
function wipe(){if(confirm('بدك تمسح كل البيانات؟ ما بتقدر ترجعها إلا من نسخة احتياطية.')&&confirm('متأكد؟')){S=def();save();R()}}
function ld(t){try{const d=JSON.parse(String(t).trim().replace(/[“”„]/g,'"'));if(d.days&&d.meals){mig(d);S=d;save();R();alert('تم استرجاع البيانات ✅')}else alert('النسخة مش صحيحة')}catch(e){alert('النسخة مش صحيحة')}}
function im(f){if(!f)return;const r=new FileReader();r.onload=()=>ld(r.result);r.readAsText(f)}
R();
try{localStorage.removeItem('ali-ai-key')}catch(e){}
try{if(navigator.storage&&navigator.storage.persist)navigator.storage.persist();if('serviceWorker' in navigator&&location.protocol=='https:')navigator.serviceWorker.register('sw.js').catch(()=>{})}catch(e){}
</script>
</body>
</html>
